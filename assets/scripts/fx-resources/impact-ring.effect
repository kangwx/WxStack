CCEffect %{
  techniques:
  - passes:
    - vert: ring-vs:vert
      frag: ring-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        ringParams: { value: [10, 3.5, 25.5, 0.65] }
}%

CCProgram ring-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    color = a_color;
    uv0 = a_texCoord;
    return cc_matViewProj * pos;
  }
}%

CCProgram ring-fs %{
  precision highp float;
  in vec4 color;
  in vec2 uv0;
  uniform RingParameters {
    vec4 ringParams;
  };
  vec4 frag () {
    float distancePx = length(uv0 - vec2(0.5)) * ringParams.z;
    float edge = abs(distancePx - ringParams.x);
    float halfWidth = ringParams.y * 0.5;
    float coverage = 1.0 - smoothstep(halfWidth - ringParams.w, halfWidth + ringParams.w, edge);
    return vec4(color.rgb, color.a * coverage);
  }
}%
